soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel/pixelstats",
        "hardware/google/pixel/power-libperfmgr",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_log_interface",
    interfaces: [
        "vendor.mediatek.hardware.log@1.0::ILog",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_atcid_interface",
    interfaces: [
        "vendor.mediatek.hardware.atci@1.0::IAtcid",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_apmservice_interface",
    interfaces: [
        "vendor.mediatek.hardware.apmonitor@2.0::IApmService",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_dmcservice_interface",
    interfaces: [
        "vendor.mediatek.hardware.dmc@1.0::IDmcService",
        "vendor.mediatek.hardware.dmc@1.1::IDmcService",
        "vendor.mediatek.hardware.dmc@1.2::IDmcService",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_olc_interface",
    interfaces: [
        "vendor.oplus.hardware.olc@2.0::IOplusLogCore",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_mdmonitor_interface",
    interfaces: [
        "vendor.mediatek.hardware.mdmonitor@1.0::IMDMonitorService",
    ],
}

prebuilt_hidl_interfaces {
    name: "hidl_vendor_mediatek_hardware_engineermode_interface",
    interfaces: [
        "vendor.mediatek.hardware.engineermode@1.0::IEmd",
        "vendor.mediatek.hardware.engineermode@1.1::IEmd",
        "vendor.mediatek.hardware.engineermode@1.2::IEmd",
        "vendor.mediatek.hardware.engineermode@1.3::IEmd",
    ],
}

cc_library_shared {
    name: "android.hardware.audio@7.0-util.op6893",
    vendor: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "audio_util/CoreUtils.cpp",
    ],
    shared_libs: [
        "android.hardware.audio.common@7.0",
        "android.hardware.audio.common@7.0-enums",
        "android.hardware.audio.common@7.0-util",
        "android.hardware.audio.common-util",
        "android.hardware.audio@7.0",
        "libbase",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    export_shared_lib_headers: [
        "android.hardware.audio.common-util",
    ],
    header_libs: [
        "libaudio_system_headers",
        "libhardware_headers",
    ],
    export_include_dirs: [
        "audio_util/include",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-DMAJOR_VERSION=7",
        "-DMINOR_VERSION=0",
        "-include common/all-versions/VersionMacro.h",
    ],
}
